# Copy to .env and fill in only the providers you have. Missing providers are skipped.
# Put every bucket in US East so no provider gets a geography advantage.

# Amazon S3 (us-east-2: the AWS org this ran in only allows that region)
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-2
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=

# Cloudflare R2 (location hint: enam)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Railway Buckets (region: iad)
RAILWAY_BUCKET=
RAILWAY_ENDPOINT=https://t3.storageapi.dev
RAILWAY_ACCESS_KEY_ID=
RAILWAY_SECRET_ACCESS_KEY=

# Backblaze B2 (us-east-005)
B2_BUCKET=
B2_REGION=us-east-005
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=

# Neon object storage (aws-us-east-1)
NEON_BUCKET=
NEON_ENDPOINT=
NEON_REGION=us-east-1
NEON_ACCESS_KEY_ID=
NEON_SECRET_ACCESS_KEY=


# Bunny Storage, through its S3-compatible endpoint (enable S3 when creating the zone)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_REGION=ny
BUNNY_STORAGE_PASSWORD=

# Convex: deploy convex-app/ and set CONVEX_BENCH_TOKEN there with `npx convex env set`
CONVEX_SITE_URL=
CONVEX_BENCH_TOKEN=
CONVEX_REGION=aws-us-east-1

# Appwrite: a bucket with read("any") so url() can return its permanent /view link
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET=bench
